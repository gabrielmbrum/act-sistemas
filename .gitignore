# ==========================================
# .gitignore - Projeto Act Sistemas
# ==========================================

# Dependências (nunca devem ir para o repositório)
node_modules/
actsis-web/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build, Cache e Saídas estáticas
.next/
actsis-web/.next/
out/
actsis-web/out/
build/
actsis-web/build/
dist/
actsis-web/dist/
*.tsbuildinfo
next-env.d.ts
actsis-web/next-env.d.ts

# Variáveis de Ambiente, Chaves e Segredos
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Logs de execução e debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Plataformas de Deploy (Vercel, Cloudflare, etc.)
.vercel
actsis-web/.vercel

# Arquivos do Sistema Operacional e Editores
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Cobertura de Testes
coverage/
actsis-web/coverage/
